# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
# The Unity project lives in a subfolder, so these point into it
/AmnesiaTheMissingMemory(game)/[Ll]ibrary/
/AmnesiaTheMissingMemory(game)/[Tt]emp/
/AmnesiaTheMissingMemory(game)/[Oo]bj/
/AmnesiaTheMissingMemory(game)/[Bb]uild/
/AmnesiaTheMissingMemory(game)/[Bb]uilds/
/AmnesiaTheMissingMemory(game)/[Ll]ogs/
/AmnesiaTheMissingMemory(game)/[Uu]ser[Ss]ettings/
.vs/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/AmnesiaTheMissingMemory(game)/[Mm]emoryCaptures/

# Recordings can get excessive in size
/AmnesiaTheMissingMemory(game)/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/AmnesiaTheMissingMemory(game)/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/AmnesiaTheMissingMemory(game)/ServerData
/AmnesiaTheMissingMemory(game)/[Aa]ssets/StreamingAssets/aa*
/AmnesiaTheMissingMemory(game)/[Aa]ssets/AddressableAssetsData/link.xml*
/AmnesiaTheMissingMemory(game)/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/AmnesiaTheMissingMemory(game)/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/AmnesiaTheMissingMemory(game)/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/AmnesiaTheMissingMemory(game)/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/AmnesiaTheMissingMemory(game)/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/AmnesiaTheMissingMemory(game)/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/AmnesiaTheMissingMemory(game)/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# UI Toolkit auto generated files
/AmnesiaTheMissingMemory(game)/UIElementsSchema/

# Auto-generated cache in Assets folder
/AmnesiaTheMissingMemory(game)/[Aa]ssets/[Ss]ceneDependencyCache*

# ---- AmnesiaAPI ----
# build output
/AmnesiaAPI/[Bb]in/
/AmnesiaAPI/[Oo]bj/

# keep the API's real project files (must stay below the *.csproj / *.slnx rules above)
!/AmnesiaAPI/AmnesiaAPI.csproj
!/AmnesiaAPI/AmnesiaAPI.slnx
